{
    "name": "html-to-vid",
    "version": "1.0.0",
    "description": "AI-powered video generation from HTML animations",
    "main": "src/index.ts",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "start": "tsx src/index.ts",
        "build": "tsc",
        "test": "tsx tests/integration/pipeline.test.ts",
