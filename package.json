        "@fastify/cors": "^11.3.0",
        "@fastify/static": "^10.1.3",
        "@types/fluent-ffmpeg": "^2.1.28",
        "@types/uuid": "^10.0.0",
        "acorn": "^8.18.0",
        "bcryptjs": "^3.0.3",
        "cheerio": "^1.2.0",
        "dotenv": "^17.4.2",
        "fastify": "^5.11.3",
        "fluent-ffmpeg": "^2.1.3",
        "jose": "^6.2.12",
        "pg": "^8.23.0",
        "playwright": "^1.62.1",
        "tsx": "^4.23.11",
        "uuid": "^14.0.1",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/node": "^26.2.0",
        "@types/pg": "^8.23.1",
        "typescript": "^7.0.2"
