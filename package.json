{
    "name": "html-to-vid",
    "version": "1.0.0",
    "description": "AI-powered video generation from HTML animations",
    "main": "src/index.ts",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "start": "tsx src/index.ts",
        "build": "tsc",
        "test": "npm run test:unit && npm run test:integration",
        "test:unit": "tsx scripts/run-unit-tests.ts unit",
        "test:unit:fast": "tsx scripts/run-unit-tests.ts fast",
        "test:unit:heavy": "tsx scripts/run-unit-tests.ts heavy",
        "test:unit:pr": "tsx scripts/run-unit-tests.ts pr",
        "test:integration": "tsx scripts/run-unit-tests.ts integration",
        "test:e2e": "tsx scripts/run-unit-tests.ts e2e",
        "test:frontend": "tsx scripts/run-unit-tests.ts frontend",
        "test:redis": "tsx scripts/run-unit-tests.ts redis",
        "test:coverage": "tsx scripts/run-unit-tests.ts all --coverage",
        "test:coverage:pr": "tsx scripts/run-unit-tests.ts pr --coverage",
        "test:coverage:merge": "tsx scripts/merge-coverage.ts coverage/parts",
        "worker": "tsx src/worker.ts",
        "cli": "tsx src/cli.ts",
        "debug:render": "tsx scripts/debug_pipeline.ts",
        "healthcheck": "tsx scripts/healthcheck.ts"
    },
    "keywords": [
        "video",
        "html",
        "animation",
        "ai",
        "tts"
    ],
    "license": "PolyForm-Noncommercial-1.0.0",
    "type": "module",
    "dependencies": {
        "@fastify/cookie": "^11.1.2",
        "@fastify/multipart": "^9.0.3",
        "@fastify/cors": "^11.3.0",
        "@fastify/static": "^10.1.3",
        "@types/fluent-ffmpeg": "^2.1.28",
        "@types/uuid": "^10.0.0",
        "acorn": "^8.18.0",
        "bcryptjs": "^3.0.3",
        "bullmq": "^6.3.10",
        "cheerio": "^1.2.0",
        "dotenv": "^17.4.2",
        "fastify": "^5.11.3",
        "fluent-ffmpeg": "^2.1.3",
        "ioredis": "^6.0.0",
        "jose": "^6.2.12",
        "pg": "^8.23.0",
        "playwright": "^1.62.1",
        "tsx": "^4.23.11",
        "uuid": "^14.0.1",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/node": "^26.2.0",
        "@types/pg": "^8.23.1",
        "typescript": "^7.0.2"
    },
    "allowScripts": {
        "esbuild@0.28.2": true
    }
}
