PORT=3000
NODE_ENV=development

# DB
POSTGRES_DB=vidtml
POSTGRES_USER=vidtml
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://vidtml:YOUR_PASSWORD@localhost:5432/vidtml
# LLM Providers (uncomment the one you want to use)
# Provider can also be switched at runtime from the web UI (Công Cụ -> Nhà cung cấp AI)
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o

# LLM_PROVIDER=gemini
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-2.5-pro

# LLM_PROVIDER=claude
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-sonnet-4-20250514

# DeepSeek (active)
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY="sk-"
DEEPSEEK_MODEL="deepseek-chat"

# 9router (Local AI Router: http://localhost:20128/v1)
# LLM_PROVIDER=9router
# NINEROUTER_BASE_URL=http://localhost:20128/v1
# NINEROUTER_API_KEY=sk-...   # optional; auto-discovered from ~/.9router/db/data.sqlite if unset
# NINEROUTER_MODEL=ag/gemini-3.8-flash-high

# Usage tracking & cost estimation
# USAGE_LOG_ENABLED=true
# USAGE_LOG_PATH=tmp/usage.jsonl
# USAGE_PRICE_OVERRIDES={"deepseek":{"deepseek-reasoner":{"inputPer1M":0.55,"outputPer1M":2.19}}}

# TTS Providers
# Provider can also be switched at runtime from the web UI (Công Cụ -> Nhà cung cấp giọng đọc)
# Edge TTS (100% Free - No API key needed, high-quality Vietnamese Neural voices)
TTS_PROVIDER=edge
TTS_VOICE=vi-VN-HoaiMyNeural
# Voice options: vi-VN-HoaiMyNeural (Nữ), vi-VN-NamMinhNeural (Nam)

# TTS_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# TTS_VOICE=alloy

# TTS_PROVIDER=google
# GOOGLE_TTS_API_KEY=...

# TTS_PROVIDER=elevenlabs
# ELEVENLABS_API_KEY=...
# ELEVENLABS_VOICE_ID=...

# Image search (Wikimedia Commons - no API key needed)
# IMAGE_CACHE_TTL_DAYS=7                 # cache search results to avoid repeat queries
# IMAGE_MAX_QUERIES_PER_JOB=10           # per-video query cap (cache hits don't count)

# Quota & Security
# QUOTA_MAX_CONCURRENT_JOBS=3
# QUOTA_MAX_DAILY_JOBS=20
# QUOTA_DAILY_BUDGET_USD=0.5
# TRUST_PROXY=0

# Google OAuth 2.0 SSO — 'Tiếp tục với Google' (1-click login/register)
# Create credentials: https://console.cloud.google.com/apis/credentials
#   Type: Web application  ->  Authorized redirect URI: http://localhost:3000/api/auth/google/callback
# Leave empty to disable the Google button and return 503 on /api/auth/google
# GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-...
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback   # optional; default: request protocol+host

# Video defaults
DEFAULT_FPS=30
DEFAULT_WIDTH=1920
DEFAULT_HEIGHT=1080
RENDER_MAX_CONCURRENCY=4
# RENDER_ALLOW_NO_SANDBOX=1

# Customer Feedback (EmailJS / MailJS & SMTP)
# Email nhận thông báo phản hồi từ khách hàng:
FEEDBACK_TARGET_EMAIL=khanh2k5xxx@gmail.com

# 1. Cấu hình EmailJS (MailJS - Miễn phí, không cần tài khoản SMTP)
# Đăng ký tại https://www.emailjs.com:
# EMAILJS_SERVICE_ID=service_xxxx
# EMAILJS_TEMPLATE_ID=template_xxxx
# EMAILJS_PUBLIC_KEY=public_key_xxxx
# EMAILJS_PRIVATE_KEY=private_key_xxxx  # optional

# 2. Hoặc cấu hình SMTP thông thường:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-16-char-app-password
# SMTP_FROM="VidTML Support <your-email@gmail.com>"


